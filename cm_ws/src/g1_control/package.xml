<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_control</name>
  <version>0.0.1</version>
  <description>ROS 2 interface for the Unitree G1</description>
  <maintainer email="danielpmorton@gmail.com">Daniel Morton</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>unitree_hg</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>g1_control_msgs</depend>
  <depend>xrobo_ros2</depend>
  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
